# Dynamic User-Defined Skills Agent Platform Environment Variables
# Copy to .env for local overrides if needed

# Default LLM Provider (mock, openai, gemini, groq)
VITE_DEFAULT_LLM_PROVIDER=mock

# Optional API Keys (Users can also configure these securely in the UI)
VITE_OPENAI_API_KEY=
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=

# Application Mode
VITE_APP_TITLE="SkillCraft AI - Agent Skills Platform"
